# Public hostname of the relay; DNS must point at this Docker host (ports 80/443 open).
PORTCULLIS_HOST=collab.example.com
PUBLIC_URL=https://collab.example.com
# Let's Encrypt account e-mail.
ACME_EMAIL=admin@example.com

# OIDC issuer (no trailing slash), e.g. https://auth.example.com
OIDC_ISSUER_URL=https://auth.example.com
# Browser login client for oauth2-proxy (web app, authorization code + PKCE,
# redirect URI ${PUBLIC_URL}/oauth2/callback). A public client still needs a
# non-empty secret here; any placeholder works.
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# 32 random bytes: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
# Restrict who may sign in by e-mail domain (default: anyone the issuer admits).
# OAUTH2_PROXY_EMAIL_DOMAINS=example.com

# Client the omp plugin logs in with (native app, device code + refresh token).
PLUGIN_CLIENT_ID=

# Who may open rooms (comma-separated identities as the issuer's email claim).
HOST_ALLOW=you@example.com
